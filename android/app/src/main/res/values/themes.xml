<resources>
    <style name="Theme.ListPro" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.ListPro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lime</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ListPro</item>
    </style>
</resources>
